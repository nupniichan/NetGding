{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Llm": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ModelName": "nvidia/nemotron-3-super-120b-a12b:free",
    "HttpTimeoutSeconds": 120,
    "Temperature": 0.3,
    "MaxTokens": 2048
  },
  "Collector": {
    "LookbackDays": 30,
    "OutputDirectory": "collected-data",
    "WebApiPublishEnabled": false,
    "WebApiBaseUrl": "http://localhost:5001",
    "WebApiHttpTimeoutSeconds": 10,
    "PublishMaxRetries": 3,
    "ChartEnabled": true
  },
  "WebApi": {
    "TelegramServiceUrl": "http://localhost:5002",
    "DiscordServiceUrl": "http://localhost:5003",
    "CollectorServiceUrl": "http://localhost:5000",
    "AnalyzerServiceUrl": "",
    "NewsServiceUrl": "",
    "TimeoutSeconds": 20,
    "CollectorTimeoutSeconds": 120,
    "HealthTimeoutSeconds": 10,
    "HealthProbePath": "/health",
    "AnalysisHistoryLimit": 500,
    "MaxRetries": 3,
    "NewsDefaultLimit": 20,
    "NewsMaxLimit": 200,
    "ConnectionString": "Data Source=db/trading.db"
  },
  "Telegram": {
    "ApiBaseUrl": "https://api.telegram.org",
    "PollingTimeoutSeconds": 30,
    "WebApiBaseUrl": "http://localhost:5001",
    "NotifierHttpTimeoutSeconds": 60,
    "WebApiHttpTimeoutSeconds": 180,
    "PollingErrorRetrySeconds": 5,
    "OnDemandMaxRetries": 3,
    "OnDemandRetryBaseDelaySeconds": 2
  },
  "Discord": {
    "WebApiBaseUrl": "http://localhost:5001",
    "WebApiHttpTimeoutSeconds": 180,
    "OnDemandMaxRetries": 3,
    "OnDemandRetryBaseDelaySeconds": 2
  },
  "SignalEngine": {
    "MinConfidence": 0.6,
    "TradeConfidence": 0.65,
    "ReversalConfidence": 0.8,
    "AtrSlMultiplier": 1.5,
    "AtrTpMultiplier": 2.0,
    "FastEmaPeriod": "9",
    "SlowEmaPeriod": "21"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "StreamMaxLen": 10000,
    "ConsumerPollIntervalMs": 500
  }
}